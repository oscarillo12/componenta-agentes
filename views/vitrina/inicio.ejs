<!DOCTYPE html>
<html lang="es">
<%- include('../partials/cabeza', { titulo: 'Componenta — Repuestos usados al mostrador digital' }) %>
<body>
  <%- include('../partials/header-publico') %>

  <section class="hero">
    <div class="contenedor" style="padding-top:0; padding-bottom:0;">
      <h1>El mostrador digital de tu <span class="acento">desarmaduría</span></h1>
      <p>Repuestos usados, publicados directo desde el galpón. Sin vueltas, sin relleno — la pieza que buscas, con precio claro.</p>

      <form class="buscador" method="GET" action="/">
        <input type="text" name="q" placeholder="Ej: alternador Hilux, parachoques Corsa..." value="<%= busqueda %>" />
        <button type="submit">Buscar</button>
      </form>
    </div>
  </section>

  <div class="contenedor">
    <% if (busqueda) { %>
      <p style="color:var(--cemento); margin-bottom:-10px;">
        Resultados para "<strong><%= busqueda %></strong>" — <%= piezas.length %> encontrados
        · <a href="/" style="color:var(--oxido); text-decoration:underline;">limpiar búsqueda</a>
      </p>
    <% } %>

    <% if (piezas.length === 0) { %>
      <div class="vacio">
        <div class="display">No encontramos piezas con esa búsqueda</div>
        <p>Prueba con otro término, o revisa más tarde — el catálogo se actualiza todos los días.</p>
      </div>
    <% } else { %>
      <div class="grid-piezas">
        <% piezas.forEach(p => { %>
          <% const esExterno = p.fuente !== 'componenta'; %>
          <a class="ficha-pieza"
             href="<%= p.url %>"
             <%= esExterno ? 'target="_blank" rel="noopener noreferrer"' : '' %>>

            <span class="etiqueta-cat"><%= p.categoria || 'Repuesto' %></span>

            <% if (esExterno) { %>
              <span class="badge-fuente badge-<%= p.fuente %>">
                <%= p.fuente === 'mercadolibre' ? 'MercadoLibre' : 'Facebook' %>
              </span>
            <% } %>

            <div class="foto-wrap">
              <% if (p.imagen) { %>
                <img src="<%= p.imagen %>" alt="<%= p.nombre %>" loading="lazy" />
              <% } else { %>
                <div class="sin-foto">Sin foto</div>
              <% } %>
            </div>

            <div class="info">
              <h3><%= p.nombre %></h3>
              <div class="vehiculo">
                <%= p.marcaVehiculoProbable || 'Vehículo' %> · <%= p.modeloVehiculoProbable || 'consultar' %>
              </div>
              <div class="precio">$<%= Number(p.precio || 0).toLocaleString('es-CL') %></div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%- include('../partials/pie') %>
</body>
</html>
